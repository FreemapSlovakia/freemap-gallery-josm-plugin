<project default="compile">
  <property name="josm.jar" location="${user.home}/josm-tested.jar" />

  <target name="compile">
    <mkdir dir="bin" />

    <javac srcdir="src" destdir="bin" release="17" includeantruntime="false">
      <classpath>
        <pathelement path="${josm.jar}" />
      </classpath>
    </javac>
  </target>

  <target name="clean">
    <delete dir="bin"/>
    <delete file="freemap-gallery.jar"/>
  </target>

  <target name="jar" depends="compile">
    <jar destfile="freemap-gallery.jar" basedir="bin" includes="**/*">
      <fileset dir=".">
        <include name="images/*" />
      </fileset>

      <manifest>
        <attribute name="Plugin-Mainversion" value="18723" />
        <attribute name="Plugin-Version" value="5" />
        <attribute name="Plugin-Class" value="sk.freemap.josm.plugins.gallery.FreemapGalleryPlugin" />
        <attribute name="Plugin-Description"
          value="Adds dynamic Freemap.sk Gallery layer to Imagery to view photos from zoom 14" />
        <attribute name="Author" value="Martin Ždila &lt;m.zdila@gmail.com&gt;" />
        <attribute name="Plugin-Minimum-Java-Version" value="17" />
        <attribute name="Plugin-Link"
          value="https://github.com/FreemapSlovakia/fm-gallery-josm-plugin/" />
        <attribute name="Plugin-Icon" value="images/icon.svg" />
      </manifest>
    </jar>

    <!-- JOSM reads update information from plugin.txt: the download URL followed by the jar's manifest, tab-indented. -->
    <loadresource property="plugin.manifest">
      <zipentry zipfile="freemap-gallery.jar" name="META-INF/MANIFEST.MF" />
      <filterchain>
        <tokenfilter>
          <filetokenizer />
          <replaceregex pattern="\r?\n " replace="" flags="g" />
        </tokenfilter>
        <fixcrlf eol="lf" />
        <ignoreblank />
        <prefixlines prefix="&#9;" />
      </filterchain>
    </loadresource>

    <echo file="plugin.txt" encoding="UTF-8">freemap-gallery.jar;https://github.com/FreemapSlovakia/fm-gallery-josm-plugin/raw/main/freemap-gallery.jar
${plugin.manifest}</echo>
  </target>
</project>
